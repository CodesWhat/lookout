{
  "name": "portwing-web",
  "private": true,
  "workspaces": [
    "website",
    "docs",
    "analytics"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --write .",
    "test:web": "node --test analytics/src/contract.test.ts scripts/*.test.mjs && npm --workspace website run test:headers",
    "knip": "knip",
    "budget:web": "node scripts/page-weight-budget.mjs",
    "lighthouse:marketing": "node scripts/lighthouse-budget.mjs lighthouse/marketing.cjs",
    "lighthouse:docs": "node scripts/lighthouse-budget.mjs lighthouse/docs.cjs",
    "lighthouse": "npm run lighthouse:marketing && npm run lighthouse:docs",
    "check:web": "node scripts/node-version-contract.mjs && npm run test:web && npm run lint && npm run knip && npm run build && npm run budget:web && npm run lighthouse"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "chrome-launcher": "1.2.1",
    "knip": "6.34.0",
    "lighthouse": "13.4.1",
    "turbo": "2.10.12"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "next": {
      "sharp": "^0.35.4"
    }
  },
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24.0.0"
  }
}
